# SOC Copilot v9.2 Final Competition Edition — server-side configuration only.
# Copy to .env for local use. Never commit the real .env file.

AUTH_REQUIRED=true
SOC_COPILOT_USERNAME=
SOC_COPILOT_PASSWORD=
SOC_COPILOT_DISPLAY_NAME=Demo Analyst
SOC_COPILOT_ROLE=analyst
SESSION_TTL_MIN=240

DEMO_MODE=true
DEMO_PERSIST_WRITES=false
RATE_LIMIT_PER_MIN=180
ALLOW_CLOUD_CASE_CONTEXT=true

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-6

VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GREYNOISE_API_KEY=
MISP_URL=
MISP_API_KEY=

SPLUNK_URL=https://splunk.example.com:8089
SPLUNK_TOKEN=
SENTINEL_WORKSPACE_ID=
AZURE_BEARER_TOKEN=
GOOGLE_SECOPS_HEALTH_URL=
GOOGLE_SECOPS_BEARER_TOKEN=

CROWDSTRIKE_BASE_URL=https://api.crowdstrike.com
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
DEFENDER_XDR_BEARER_TOKEN=

SERVICENOW_URL=https://your-instance.service-now.com
SERVICENOW_TOKEN=
SERVICENOW_USER=
SERVICENOW_PASSWORD=

PROOFPOINT_TAP_URL=https://tap-api-v2.proofpoint.com
PROOFPOINT_PRINCIPAL=
PROOFPOINT_SECRET=
MICROSOFT_GRAPH_BEARER_TOKEN=
